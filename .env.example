# Never commit a real .env file or database password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/opportunity_atlas?retryWrites=true&w=majority
MONGODB_DB=opportunity_atlas
# Comma-separated public frontend URLs; exact origins only.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://<your-vercel-project>.vercel.app
